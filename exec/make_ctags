#!/bin/bash
# Build tags for the current tree. Demo data directories never receive links.
# Requires Bash and GNU find/sort, as used by the Linux development machines.
set -euo pipefail

[[ $# -eq 0 ]] || { echo "usage: make_ctags" >&2; exit 1; }
command -v ctags >/dev/null || { echo "'ctags' program not found" >&2; exit 1; }

# Serialize tags publication even when this helper is run directly.
# Keep the lock file: unlinking it would break flock.
exec 8>cscope.ctags.lock
flock -n 8 || { echo "another tags build is running in $PWD" >&2; exit 1; }

# Default to eight workers at most; allow an explicit 1..16 for slower/faster
# machines. More workers need more memory and usually give diminishing returns.
jobs=${MYTOOL_CTAGS_JOBS:-}
if [[ -z $jobs ]]; then
    jobs=$(getconf _NPROCESSORS_ONLN)
    (( jobs <= 8 )) || jobs=8
fi
if [[ ! $jobs =~ ^([1-9]|1[0-6])$ ]]; then
    echo "MYTOOL_CTAGS_JOBS must be an integer from 1 to 16" >&2
    exit 1
fi

root=$(pwd -P)
# A sibling temporary directory makes the final rename stay on one filesystem.
# Old tags remain usable until every worker and the final sort have succeeded.
work=$(mktemp -d ./cscope.ctags.XXXXXX)
pids=()
cleanup()
{
    if (( ${#pids[@]} )); then
        kill "${pids[@]}" 2>/dev/null || :
        wait "${pids[@]}" 2>/dev/null || :
    fi
    rm -rf -- "$work"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

collect_sources()
{
    # Preserve the original extensions and FULL-PATH filters. In particular,
    # "*test*" differs from mytool's "*/test/*"; the lists are not interchangeable.
    # Record source bytes for load balancing, not just the length of file names.
    find "$root" -type f \( -name '*.[chyl]' -o -name '*.cc' \
        -o -name '*.[ch]pp' -o -name '*.py' -o -name '*.rs' -o -name '*.go' \) \
        ! -path '*test*' ! -path '*mock/*' ! -path '*mars/*' \
        ! -path '*aws*' ! -path '*viewer*' -printf '%s\t%p\n' > "$work/sources"
}

build_tags()
{
    local version shard pid status=0
    version=$(ctags --version 2>&1 || :)
    case "$version" in
        *Universal*|*Exuberant*)
            # Greedily assign the largest sources to the least-loaded worker.
            # At most 16 small counters are needed. Spaces/tabs in paths survive
            # removal of the first size field; newline file names are unsupported
            # by the line-based ctags -L interface.
            : > "$work/input.0"
            LC_ALL=C sort -nr -k1,1 "$work/sources" |
                awk -v jobs="$jobs" -v prefix="$work/input." '
                    {
                        size = $1
                        sub(/^[^\t]*\t/, "")
                        worker = 0
                        for (i = 1; i < jobs; i++)
                            if (bytes[i] < bytes[worker])
                                worker = i
                        print > (prefix worker)
                        bytes[worker] += size
                    }'

            # Workers never append to a shared file. Each writes an unsorted
            # shard; the parent waits for ALL workers before merging anything.
            for shard in "$work"/input.*; do
                ctags --kinds-C=+defgmstv --kinds-C++=+cdefgmstuv \
                    --sort=no -f "$shard.tags" -L "$shard" &
                pids+=("$!")
            done
            for pid in "${pids[@]}"; do
                wait "$pid" || status=1
                pids=("${pids[@]:1}")
            done
            (( status == 0 )) || return 1

            # One global byte-order sort replaces repeated append/sort cycles.
            # Deduplicate pseudo headers and advertise the restored sort order
            # so Vim can use binary search. These flags preserve the old kinds.
            LC_ALL=C sort --parallel="$jobs" -u "$work"/input.*.tags |
                sed 's/^!_TAG_FILE_SORTED\t0\t/!_TAG_FILE_SORTED\t1\t/' > "$work/tags"
            ;;
        *)
            # Retain the old serial -dt fallback for non-Exuberant ctags.
            # NUL-separated xargs handles spaces without requiring -L support.
            : > "$work/tags"
            cut -f2- "$work/sources" | tr '\n' '\0' |
                xargs -0 -r ctags -a -f "$work/tags" -dt
            LC_ALL=C sort "$work/tags" -o "$work/tags"
            ;;
    esac
    mv -fT -- "$work/tags" tags
}

update_tag_links()
{
    local directory link relative remainder
    # Skip metadata, demo data, and both builders' private work directories.
    # Materialize the directory list first so a failed find stops visibly.
    find . \( -name .git -o -name CVS -o -path "$work" \
        -o -name 'cscope.build.*' -o -path './gpAux/gpdemo' \) -prune -o \
        -type d -print0 > "$work/directories"

    # Remove stale links left by older versions, but preserve ordinary files
    # named tags and anything that does not point to this tree's tags file.
    if [[ -d gpAux/gpdemo ]]; then
        find gpAux/gpdemo -type l -name tags -print0 > "$work/demo-links"
        while IFS= read -r -d '' link; do
            if [[ $link -ef tags ]]; then
                rm -- "$link"
            fi
        done < "$work/demo-links"
    fi

    while IFS= read -r -d '' directory; do
        [[ $directory != . ]] || continue
        link=$directory/tags

        # -ef compares the resolved device/inode using a Bash builtin: no
        # readlink/sed process per directory, and no writes for correct links.
        if [[ -L $link && $link -ef tags ]]; then
            continue
        fi
        if [[ -e $link && ! -L $link ]]; then
            echo "refusing to replace a non-symlink: $link" >&2
            return 1
        fi

        # Construct ../../tags with shell operations only. For ./a/b, two
        # iterations give ../../tags regardless of spaces in either component.
        relative=tags
        remainder=${directory#./}
        while [[ -n $remainder ]]; do
            relative=../$relative
            case "$remainder" in
                */*) remainder=${remainder#*/} ;;
                *) remainder= ;;
            esac
        done
        ln -sfnT -- "$relative" "$link"
    done < "$work/directories"
}

collect_sources
build_tags
update_tag_links
