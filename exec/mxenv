#!/usr/bin/env bash

# Configure or generate an environment for one MatrixDB worktree/build tree.
# The default workspace is the current directory, so changing directories
# selects another installation and demo cluster.

set -euo pipefail

usage()
{
	cat <<'EOF'
Usage:
  mxenv -e [options]       generate mxdb-env.sh
  mxenv -c [options]       run configure with the mytool development options
  mxenv -d [options]       generate it, then create a demo cluster

Options:
  -w DIR   build directory or in-tree worktree (default: current directory)
  -s DIR   source worktree (normally detected from the build directory)
  -D       debug configure: -O0 -g2 (default: release, -O3 -g2)
  -n NUM   number of primary segments (default: 3)
  -m       create mirrors and standby (default: neither)
  -o FILE  environment file (default: WORKSPACE/mxdb-env.sh)
  -h       show this help

Ports are selected automatically from 5658 for a new demo cluster.
With -e, an existing cluster keeps its own coordinator port.

Examples:
  cd ~/work/matrixdb-feature
  mxenv -c
  mxenv -c -D
  mxenv -e
  source ./mxdb-env.sh

  cd ~/work/matrixdb-feature-build
  mxenv -c -s ../matrixdb-feature
  mxenv -e
  source ./mxdb-env.sh

  # After building and installing this workspace:
  mxenv -d
  source ./mxdb-env.sh
  gpstop -a
  gpstart -a
EOF
}

die()
{
	echo "mxenv: $*" >&2
	exit 1
}

detect_source()
{
	local makefile="${WORKSPACE}/src/Makefile.global"
	local source

	# A configured VPATH build records its source worktree here.
	if [[ -f "${makefile}" ]] &&
		grep -Eq '^vpath_build[[:space:]]*=[[:space:]]*yes$' "${makefile}"; then
		source=$(sed -n 's/^abs_top_srcdir[[:space:]]*=[[:space:]]*//p' \
			"${makefile}" | head -n 1)
		[[ -n "${source}" ]] || die "cannot read abs_top_srcdir from ${makefile}"
		realpath -m "${source}"
		return
	fi

	# In an in-tree build, the workspace is also the source worktree.
	[[ -f "${WORKSPACE}/configure" ]] ||
		die "cannot detect the source worktree; use -s DIR"
	realpath "${WORKSPACE}"
}

write_env()
{
	local mirrors=$1
	local coordinator="${DATADIRS}/qddir/demoDataDir-1"

	{
		cat <<'EOF'
#!/usr/bin/env bash
# Generated by mxenv. Source this file before using MatrixDB commands.
EOF
		printf 'export MXSRC=%q\n' "${SOURCE}"
		printf 'export GPSRC=%q\n' "${SOURCE}"
		printf 'export MXBUILD=%q\n' "${WORKSPACE}"
		printf 'export GPHOME=%q\n' "${GPHOME}"
		cat <<'EOF'

if [[ -f "${GPHOME}/greenplum_path.sh" ]]; then
	# shellcheck source=/dev/null
	source "${GPHOME}/greenplum_path.sh"
else
	export PATH="${GPHOME}/bin:${PATH}"
	export LD_LIBRARY_PATH="${GPHOME}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
fi

# Do not let an older demo environment override this workspace's DATADIRS.
unset COORDINATOR_DATADIR

EOF
		printf 'export PORT_BASE=%q\n' "${PORT}"
		printf 'export PGPORT=%q\n' "${PORT}"
		printf 'export DATADIRS=%q\n' "${DATADIRS}"
		printf 'export NUM_PRIMARY_MIRROR_PAIRS=%q\n' "${SEGMENTS}"
		printf 'export WITH_MIRRORS=%q\n' "${mirrors}"
		printf 'export WITH_STANDBY=%q\n' "${mirrors}"
		printf 'export COORDINATOR_DATA_DIRECTORY=%q\n' "${coordinator}"
		printf 'export MASTER_DATA_DIRECTORY=%q\n' "${coordinator}"
	} >"${ENV_FILE}"

	echo "wrote ${ENV_FILE} (PORT_BASE=${PORT})"
}

configure_workspace()
{
	local flags='-O3 -g2 -Wno-uninitialized -Wno-maybe-uninitialized'
	if [[ "${DEBUG_MODE}" == true ]]; then
		flags='-O0 -g2'
	fi

	(
		cd "${WORKSPACE}"
		CFLAGS="${flags}" CXXFLAGS="${flags}" \
			"${SOURCE}/configure" \
			--with-lz4 --with-zstd --with-libxml --enable-depend \
			--with-openssl --with-perl --with-python --disable-awssdk \
			--prefix="${GPHOME}"
	)
}

find_port()
{
	# gpdemo reserves base+1 for standby even without mirrors.
	local ports_needed=$((2 + SEGMENTS))
	[[ "${MIRRORS}" == true ]] && ports_needed=$((ports_needed + SEGMENTS))

	if ! PORT=$(python3 - "${PORT_START}" "${ports_needed}" <<'PY'
import errno
import os
import socket
import sys

start = int(sys.argv[1])
ports_needed = int(sys.argv[2])
last_start = 65535 - ports_needed + 1

def port_is_free(port):
    path = f"/tmp/.s.PGSQL.{port}"
    if os.path.lexists(path) or os.path.lexists(path + ".lock"):
        return False
    for family, address in ((socket.AF_INET, "0.0.0.0"),
                            (socket.AF_INET6, "::")):
        try:
            with socket.socket(family, socket.SOCK_STREAM) as sock:
                sock.bind((address, port))
        except OSError as error:
            if family == socket.AF_INET6 and error.errno in (
                    errno.EAFNOSUPPORT, errno.EPROTONOSUPPORT, errno.EADDRNOTAVAIL):
                continue
            return False
    return True

for candidate in range(start, last_start + 1):
    if all(port_is_free(candidate + offset) for offset in range(ports_needed)):
        print(candidate)
        break
else:
    raise SystemExit(1)
PY
	); then
		die "cannot find ${ports_needed} consecutive available ports from ${PORT_START}"
	fi
}

find_existing_port()
{
	local coordinator="${DATADIRS}/qddir/demoDataDir-1"

	if [[ -f "${coordinator}/postmaster.pid" ]]; then
		PORT=$(sed -n '4p' "${coordinator}/postmaster.pid")
	else
		# postgres -C reads includes and postgresql.auto.conf without starting.
		PORT=$(LD_LIBRARY_PATH="${GPHOME}/lib${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}" \
			"${GPHOME}/bin/postgres" -D "${coordinator}" -C port) ||
			die "cannot read the existing cluster's port: ${coordinator}"
	fi
	if [[ ! "${PORT}" =~ ^[1-9][0-9]{0,4}$ ]] || ((PORT > 65535)); then
		die "invalid coordinator port in ${coordinator}: ${PORT}"
	fi
}

create_demo()
{
	[[ -f "${GPHOME}/greenplum_path.sh" ]] ||
		die "${GPHOME}/greenplum_path.sh is missing; install this workspace first"
	[[ -f "${WORKSPACE}/GNUmakefile" || -f "${WORKSPACE}/Makefile" ]] ||
		die "${WORKSPACE} is not a configured MatrixDB build directory"

	set +u
	# shellcheck source=/dev/null
	source "${ENV_FILE}"
	set -u

	# demo_cluster.sh gives inherited coordinator paths precedence over
	# DATADIRS. Clear them for this command so another sourced cluster cannot
	# redirect or delete this workspace's data directory.
	env -u COORDINATOR_DATADIR \
		-u COORDINATOR_DATA_DIRECTORY \
		-u MASTER_DATA_DIRECTORY \
		GPHOME="${GPHOME}" \
		PATH="${PATH}" \
		LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}" \
		PORT_BASE="${PORT}" \
		DATADIRS="${DATADIRS}" \
		NUM_PRIMARY_MIRROR_PAIRS="${SEGMENTS}" \
		WITH_MIRRORS="${MIRRORS}" \
		WITH_STANDBY="${MIRRORS}" \
		make -C "${WORKSPACE}" create-demo-cluster
}

MODE=
WORKSPACE=${PWD}
SOURCE=
PORT=
PORT_START=5658
SEGMENTS=3
MIRRORS=false
DEBUG_MODE=false
ENV_FILE=

while getopts ':eDcdw:s:n:mo:h' option; do
	case "${option}" in
		e) MODE="env" ;;
		D) DEBUG_MODE=true ;;
		c) MODE=configure ;;
		d) MODE=demo ;;
		w) WORKSPACE=${OPTARG} ;;
		s) SOURCE=${OPTARG} ;;
		n) SEGMENTS=${OPTARG} ;;
		m) MIRRORS=true ;;
		o) ENV_FILE=${OPTARG} ;;
		h) usage; exit 0 ;;
		:) die "option -${OPTARG} requires an argument" ;;
		\?) die "unknown option: -${OPTARG}" ;;
	esac
done
shift $((OPTIND - 1))

[[ $# -eq 0 ]] || die "unexpected argument: $1"
[[ -n "${MODE}" ]] || { usage >&2; exit 1; }
if [[ ! "${SEGMENTS}" =~ ^[1-9][0-9]{0,4}$ ]] || ((SEGMENTS > 65533)); then
	die "invalid segment count: ${SEGMENTS}"
fi
if [[ "${DEBUG_MODE}" == true && "${MODE}" != configure ]]; then
	die "option -D is only valid with -c"
fi
[[ -d "${WORKSPACE}" ]] || die "workspace does not exist: ${WORKSPACE}"

WORKSPACE=$(realpath "${WORKSPACE}")
if [[ -n "${SOURCE}" ]]; then
	[[ -d "${SOURCE}" ]] || die "source worktree does not exist: ${SOURCE}"
	SOURCE=$(realpath "${SOURCE}")
else
	SOURCE=$(detect_source)
fi
[[ -f "${SOURCE}/configure" ]] || die "not a MatrixDB source worktree: ${SOURCE}"

GPHOME="${WORKSPACE}/bin"
if [[ "${MODE}" == configure ]]; then
	configure_workspace
	exit 0
fi

DATADIRS="${WORKSPACE}/data"
if [[ -z "${ENV_FILE}" ]]; then
	ENV_FILE="${WORKSPACE}/mxdb-env.sh"
else
	ENV_FILE=$(realpath -m "${ENV_FILE}")
fi
[[ -d "$(dirname "${ENV_FILE}")" ]] ||
	die "environment file directory does not exist: $(dirname "${ENV_FILE}")"

if [[ "${MODE}" == env && -f "${DATADIRS}/qddir/demoDataDir-1/postgresql.conf" ]]; then
	find_existing_port
else
	find_port
fi

write_env "${MIRRORS}"
[[ "${MODE}" == env ]] || create_demo
